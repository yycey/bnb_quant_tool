# 复制为项目根 .env 后填写（勿提交 .env）
# cp .env.example .env

# --- LLM（至少填一家；环境变量优先于 config.yaml 明文）---
DEEPSEEK_API_KEY=
QIANWEN_API_KEY=
# 或 DASHSCOPE_API_KEY=
ARK_API_KEY=
# 或 VOLCENGINE_API_KEY=

# --- 交易所（可选，只读行情可不填）---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Web 控制台（若启用）---
WEB_API_TOKEN=
BNB_PYTHON_PATH=/usr/bin/python3

# --- 运行剖面：validation=持续开平验证；production=严门控盈利优先 ---
BNB_TRADING_PROFILE=validation
